## DeepSeek
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

## Database (容器内 hostname,生产保持不变)
POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD_32CHARS
POSTGRES_DB=ff
DATABASE_URL=postgres://postgres:REPLACE_ME_STRONG_PASSWORD_32CHARS@postgres:5432/ff

## Redis / 内部服务
REDIS_URL=redis://redis:6379
DEFENDER_URL=http://defender:8080
TARGET_URL=http://target:80

## Web 鉴权
## 留空则禁用鉴权(只在本地开发用,生产必填)
AUTH_PASSWORD=REPLACE_ME_LOGIN_PASSWORD
## openssl rand -hex 32 生成
AUTH_SECRET=REPLACE_ME_64CHARS_HEX_FROM_OPENSSL_RAND
