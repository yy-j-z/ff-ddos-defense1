# 本地混合模式环境变量(复制为 .env.local 并填入真实密钥)

# --- LLM ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 数据存储 ---
DATABASE_URL=postgres://postgres:dev@localhost:5432/ff
REDIS_URL=redis://localhost:6379

# --- 依赖服务 ---
# PCAP 分析服务(docker 内为 http://pcap-analyzer:8001)
ANALYZER_URL=http://localhost:8001
DEFENDER_URL=http://localhost:8080
TARGET_URL=http://localhost:8090
# Verifier 读取的 defender 拦截日志路径(默认 /var/log/defender/defender.log)
DEFENDER_LOG_PATH=/var/log/defender/defender.log

# --- 登录鉴权(账号密码写在这里即可,生产环境务必修改) ---
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=admin
# 用于签发登录 cookie 的密钥,改成一段随机字符串(可用 openssl rand -hex 32 生成)
APP_AUTH_SECRET=ff-ddos-defense-dev-secret-change-me
